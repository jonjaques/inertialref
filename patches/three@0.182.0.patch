+++ b/build/three.webgpu.js
@@ -79413,6 +79413,12 @@ class WebGPUBackend extends Backend {
 
 		if ( pipelineData.error === true ) return;
 
+		// A pipeline `compileAsync` is still building has no GPU object yet:
+		// `createRenderPipelineAsync` resolves later, and a frame drawn before it
+		// does would hand `setPipeline` an undefined and throw out of the whole
+		// render. Draw nothing for it this frame; it lands on the next.
+		if ( pipelineGPU === undefined ) return;
+
 		const index = renderObject.getIndex();
 		const hasIndex = ( index !== null );
 

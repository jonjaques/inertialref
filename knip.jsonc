{
  "$schema": "https://unpkg.com/knip@6/schema-jsonc.json",

  /*
   * The third instrument, beside `fta` and `@vitest/coverage-v8`
   * (`design/reports/complexity.md`). Those two grade code that exists; knip
   * asks whether it needs to. A file nothing imports scores and covers like any
   * other — `fta` ranks it, coverage counts its statements — so neither of them
   * can see the cheapest simplification there is, which is deletion.
   *
   * Every workspace declares `entry` explicitly rather than leaning on the
   * defaults, because the defaults are wrong here in two ways that both read as
   * dozens of false "unused file" reports:
   *
   *  - Tests are entry points, and knip's vitest plugin only finds them in the
   *    workspace holding the vitest config. This repository has exactly one, at
   *    the root, covering all sixteen workspaces (`vitest.config.ts` says why:
   *    one Node environment for the whole tree, on purpose). So each workspace
   *    names its own test glob.
   *  - `packages/*` publishes nothing. `exports` points at `./src/index.ts`
   *    directly — there is no build step and no `dist` — so the entry is the
   *    source file itself.
   *
   * There are no `rules` here, for the reason `fta.json` carries no
   * `score_cap`: severity in the config applies to the report too, which turns
   * `pnpm knip` into something that exits 1 while printing the answer. The
   * split is on the command line instead — `pnpm knip` reports everything and
   * always exits 0, `pnpm knip:check` narrows to the four unambiguous classes
   * (files, dependencies, unlisted, unresolved) and exits 1 on any of them.
   * An unused *export* is deliberately not one of those: this repository
   * exports named constants for a test to assert against, and a component can
   * be finished before the screen that mounts it.
   */
  /*
   * `rg` is ripgrep, which `scripts/spelling/scan.mjs` shells out to for the
   * one question the TypeScript checker cannot answer: whether an identifier
   * also exists as text in checked-in data. It is a system tool, not a
   * dependency — knip is right that no package provides it.
   */
  "ignoreBinaries": ["rg"],

  "workspaces": {
    ".": {
      // `scripts/` is the build and rig layer: every one of these is invoked by
      // a `package.json` script, a hook, or another script. Nothing imports
      // them, which is exactly what makes them entry points rather than dead
      // files. `.claude/hooks/gate.mjs` is run by Claude Code's Stop hook.
      "entry": ["scripts/**/*.mjs", ".claude/hooks/*.mjs", "vitest.config.ts"],
      "project": ["scripts/**/*.mjs", ".claude/hooks/*.mjs", "*.ts"],
    },
    "apps/game": {
      /*
       * `sw.js` is fetched by the browser, not imported — `registerServiceWorker.ts`
       * passes its URL to `navigator.serviceWorker.register`, which is a string
       * to every static analyzer alive.
       *
       * `gpuSetup.ts` is named too, though `vitest.gpu.config.ts` already lists
       * it in `setupFiles`: that path is written from the repository root
       * because vitest resolves `setupFiles` against its `root` (the working
       * directory), while knip resolves a workspace config against the
       * workspace. One of the two has to be told twice.
       */
      "entry": [
        "src/main.tsx",
        "public/sw.js",
        "src/render/gpuSetup.ts",
        "vite.config.ts",
        "vitest.gpu.config.ts",
        "src/**/*.test.{ts,tsx}",
      ],
      "project": ["src/**/*.{ts,tsx}", "public/sw.js", "*.ts"],
      // The other half of the `gpuSetup.ts` path disagreement above: naming it
      // as an entry stops it reading as a dead file, and this stops the
      // workspace-relative miss reading as a broken import.
      "ignoreUnresolved": ["apps/game/src/render/gpuSetup.ts"],
      /*
       * `webgpu` is Dawn as a Node addon and `render/gpuSetup.ts` reaches it
       * through a global the addon installs, never an import. It is the device
       * `pnpm test:gpu` runs on; removing it deletes that suite.
       */
      "ignoreDependencies": ["webgpu"],
    },
    "apps/headless": {
      "entry": ["src/main.ts", "src/**/*.test.ts"],
      "project": ["src/**/*.ts"],
    },
    "apps/ingest": {
      "entry": ["src/main.ts", "src/**/*.test.ts"],
      "project": ["src/**/*.ts"],
    },
    "apps/server": {
      // Wrangler's `main` in `wrangler.jsonc` is the entry; knip's wrangler
      // plugin reads it, and `worker-configuration.d.ts` is generated by
      // `wrangler types` rather than written.
      "entry": ["src/index.ts", "src/**/*.test.ts"],
      "project": ["src/**/*.ts"],
      "ignore": ["worker-configuration.d.ts"],
    },
    "packages/*": {
      "entry": ["src/index.ts", "src/**/*.test.ts"],
      "project": ["src/**/*.ts"],
    },
  },
}

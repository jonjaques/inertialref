{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch Browser",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}/apps/game",
      "preLaunchTask": "dev",
      "sourceMaps": true,
      "sourceMapPathOverrides": {
        "/@fs/*": "/*"
      },
      "skipFiles": ["${workspaceFolder}/node_modules/**"]
    },
    {
      "name": "Attach Browser",
      "type": "chrome",
      "request": "attach",
      "port": 9222,
      "webRoot": "${workspaceFolder}/apps/game",
      "sourceMaps": true,
      "sourceMapPathOverrides": {
        "/@fs/*": "/*"
      },
      "skipFiles": ["${workspaceFolder}/node_modules/**"]
    },
    {
      "name": "Launch Node",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/apps/headless/src/main.ts",
      "args": ["--self-test"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "Attach Node",
      "type": "node",
      "request": "attach",
      "port": 9229,
      "skipFiles": ["<node_internals>/**"]
    }
  ]
}

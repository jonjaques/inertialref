# Worker secrets. Root .env.local is loaded by pnpm dev:server.
OPENAI_API_KEY=

# Accounts (src/account.ts). The secret key alone is enough, and it is also
# what reads the private metadata that grants the guide (src/tour/access.ts),
# so the guide needs it. The JWT key is the instance's PEM public key and makes
# the signature check networkless. Both unset means the Worker reports accounts
# as not configured.
CLERK_SECRET_KEY=
CLERK_JWT_KEY=

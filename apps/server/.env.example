# Worker secrets. Root .env.local is loaded by pnpm dev:server.
OPENAI_API_KEY=

# Accounts (src/account.ts). The secret key is also what reads the private
# metadata that grants the guide (src/tour/access.ts), so the guide needs it.
# On the deployed Worker CLERK_SECRET_KEY is the production instance's and
# CLERK_PREVIEW_SECRET_KEY the development instance's, chosen by host; locally
# the development key in CLERK_SECRET_KEY alone is enough. Both unset means the
# Worker reports accounts as not configured.
CLERK_SECRET_KEY=
CLERK_PREVIEW_SECRET_KEY=

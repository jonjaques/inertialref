# Worker secrets. Root .env.local is loaded by pnpm dev:server.
OPENAI_API_KEY=
TOUR_GUIDE_PASSWORD=

# Accounts (src/account.ts). The secret key alone is enough; the JWT key is the
# instance's PEM public key and makes the check networkless. Both unset means
# the Worker reports accounts as not configured.
CLERK_SECRET_KEY=
CLERK_JWT_KEY=

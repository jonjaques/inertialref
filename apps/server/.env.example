# Worker secrets. Root .env.local is loaded by pnpm dev:server.
OPENAI_API_KEY=

# Accounts (src/account.ts). The development instance's secret key; it is
# also what reads the private metadata that grants the guide
# (src/tour/access.ts). Deployed, production and Previews Base each hold their
# own instance's key under this name. CLERK_ENABLED and TOUR_GUIDE_ENABLED are
# declared in cloudflare.config.ts, on everywhere, and are not set here.
CLERK_SECRET_KEY=

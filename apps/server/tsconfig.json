{
  /* The fourth environment (AGENTS.md).
     Not the browser and not Node: workerd's globals, plus the `Env` this
     Worker's own bindings produce. Both come from `worker-configuration.d.ts`,
     which `pnpm --filter @inertialref/server run types` generates from
     wrangler.jsonc and which is committed — a binding added to the config and
     not to the checked-in types is a typecheck that passes locally and fails in
     CI, or worse, the reverse. */
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023"],
    "types": [],
    /* The health record names the catalog version, which is a fact about the
       bundle this Worker serves and lives in `data/catalog/manifest.json`. */
    "resolveJsonModule": true
  },
  "include": ["src", "worker-configuration.d.ts"]
}

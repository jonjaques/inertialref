{
  /* The fourth environment (AGENTS.md).
     Not the browser and not Node: workerd's globals, plus the `Env` this
     Worker's own bindings produce. Both come from
     `.cloudflare/types/index.d.ts`, which `pnpm --filter @inertialref/server
     run types` (`cf workers types`) generates and which is committed. It
     infers `Env` from `cloudflare.config.ts` by type, so a binding added there
     reaches this project at once — but the runtime types are pinned to the
     compatibility date the file was generated at, so a date bump without
     regenerating is a typecheck against the old runtime. */
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023"],
    "types": [],
    /* The health record names the catalog version, which is a fact about the
       bundle this Worker serves and lives in `data/catalog/manifest.json`. */
    "resolveJsonModule": true
  },
  "include": ["src", ".cloudflare/types/index.d.ts"]
}

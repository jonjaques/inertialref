---
import '../../src/index.css'
import { renderDocumentHead } from '../../src/documentHead.ts'
import type { PageMeta } from '../../src/site.ts'

interface Props {
  meta: PageMeta
}
const { meta } = Astro.props
---

<!doctype html>
<html lang="en">
  <head set:html={renderDocumentHead(meta)} /><body>
    <div id="root"><slot /></div>
    <noscript>
      <style>
        .doc-rail {
          display: block;
        }
        .doc-rail-group > div {
          display: block;
        }
        button {
          cursor: default;
        }
      </style>
    </noscript>
  </body>
</html>

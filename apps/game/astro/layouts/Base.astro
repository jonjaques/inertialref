---
import { ClientRouter } from 'astro:transitions'
import '../../src/index.css'
import {
  SITE,
  canonicalUrl,
  documentTitle,
  jsonLd,
  pageMetaFor,
} from '../../src/site.ts'

interface Props {
  /**
   * The path this document is served at.
   *
   * Defaults to `Astro.url.pathname`, which is the page's own path during
   * a build. A caller passes it only when the file that owns `<html>` is
   * not the file that owns the URL — there is no such caller yet.
   */
  pathname?: string
  /**
   * The page's own title, when it is more specific than `pageMetaFor`.
   *
   * A documentation page is "Reference frames", not "Documentation". The
   * tab strip truncates from the right, so the half that survives has to
   * be the half that says where you are.
   */
  heading?: string
  /**
   * The page's own description, when it is more specific than `pageMetaFor`.
   *
   * Same reason as `heading`: the card for `/docs/concepts/frames` is
   * about reference frames, not about the documentation section.
   */
  description?: string
}

const pathname = Astro.props.pathname ?? Astro.url.pathname
const meta = pageMetaFor(pathname)
const page =
  Astro.props.description === undefined
    ? meta
    : { ...meta, description: Astro.props.description }
const title = documentTitle(meta, Astro.props.heading)
const canonical = canonicalUrl(pathname)
const image = `${SITE.origin}${SITE.socialImage}`
const ld = JSON.stringify(jsonLd())
---

<!doctype html>
<!--
  `class="dark"` rather than a media query.

  Tailwind v4's stock `dark:` variant follows `prefers-color-scheme`, and the
  components shadcn/ui generates lean on `dark:` for their contrast steps. This
  interface has exactly one palette — it is a HUD over a starfield and there is
  no light-mode reading of it — so the class is set once, here, and
  `src/index.css` redefines the variant to key off it. Without this the whole
  registry renders in its light values on a machine set to light.
-->
<html lang="en" class="dark" transition:animate="none">
  <head>
    <meta charset="UTF-8" />
    <!--
      THE VIEWPORT, LOCKED.

      Four clauses and none of them is boilerplate.

      `viewport-fit=cover` is the one that fixes the reported bug. Without it
      iOS insets the page by the safe areas and paints the letterbox in the
      body's own color — so in an installed PWA on a notched iPhone the canvas
      stopped short of the top and bottom of the screen and the sky had black
      bands above and below it. With it the document is the whole display and
      the insets arrive as `env(safe-area-inset-*)` instead, which
      `src/index.css` turns into padding on `.hud-layer` so the chrome stays
      clear of the notch and the home indicator while the scene runs under
      them. It is also what makes `apple-mobile-web-app-status-bar-style:
      black-translucent`, set below, mean anything.

      `maximum-scale=1, user-scalable=no` because this is a simulator with its
      own pinch gesture, not a document. The planetarium reads a two-finger
      pinch as a camera zoom; with the page scalable, iOS races it with its own
      and the result is a camera that zooms while the whole interface scales
      out from under it, leaving parts of the HUD off-screen with no way to
      scroll back — the page does not scroll, by design.

      **The accessibility cost is real and is not zero.** It is easy to tell
      the flattering version — a HUD over a simulation has nothing to reflow —
      and that is false of three routes in this same document: the about page,
      the settings dialog and the cinema library are ordinary prose, and a
      reader who needs them larger cannot pinch them. What they have instead is
      that every type step is sized in `rem`, so the browser's own font-size
      setting scales the whole interface; and iOS Safari ignores
      `user-scalable=no` in a tab anyway, so the loss is real only in an
      installed copy and on Android. WCAG 1.4.4 is not met on those routes
      until they can be reached without this meta tag — splitting the
      document-shaped routes out of the simulator's viewport is the fix, and it
      is not this change.

      `interactive-widget=resizes-content` keeps the soft keyboard — the
      address field in the planetarium, the search box in the catalog — from
      sliding a fixed, unscrollable layout up out of the viewport.
    -->
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no, viewport-fit=cover, interactive-widget=resizes-content"
    />
    <meta name="color-scheme" content="dark" />

    <!--
      THE DOCUMENT HEAD.

      Interpolated from `src/site.ts`, which is the only place the product
      names itself. A social scraper does not run JavaScript, so whatever
      React later writes into these tags is invisible to the card Slack or
      iMessage draws — the values here are the card.

      Unmatched paths are `404.astro` — the menu, with a 404 status — so a
      typed URL that is not a page still answers "where am I" rather than
      wearing the home page's card. The chrome island's `DocumentMeta`
      rewrites `<title>` on an in-app navigation that does not load a new
      document.

      Per-route Open Graph is free at build time. Routing every navigation
      through the Worker so `HTMLRewriter` can rewrite four tags would turn
      a free asset request into a billed invocation, which is the trade
      `docs/hosting.md` § H-7 declines.
    -->
    <title>{title}</title>
    <meta name="description" content={page.description} />
    <link rel="canonical" href={canonical} />
    <meta name="author" content={SITE.author} />
    <!-- `max-image-preview:large` is what lets the share card be the card in a
         search result rather than a thumbnail. The rest is the default, stated
         because a missing robots tag and an explicit one read the same to a
         person and only one of them is a decision. -->
    <meta
      name="robots"
      content="index, follow, max-image-preview:large, max-snippet:-1"
    />

    <!--
      The mark, at every size a platform asks for. All of it is generated from
      `design/brand/brandmark.svg` by `pnpm brand`; `pnpm brand --check` is in
      `pnpm check` and fails if this list and that drawing have drifted apart.

      `favicon.ico` is listed *after* the SVG so a browser that understands both
      prefers the vector. It is here at all because `/favicon.ico` is the path a
      crawler, a feed reader and a bookmark importer ask for without being told.
    -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" sizes="48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!--
      Installable. The service worker (`public/sw.js`) is the other half and was
      already here: the game is a pure function of a seed, so once the bundle
      and the catalog are cached there is genuinely nothing left to fetch —
      which makes an installed copy a real offline application rather than a
      shortcut that shows a dinosaur on a plane.

      `theme-color` is slate-950, the same color as the page and the icon
      plate, so the browser's own chrome does not draw a light band above a
      black sky while the bundle loads.
    -->
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content={SITE.background} />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content={SITE.name} />
    <meta
      name="apple-mobile-web-app-status-bar-style"
      content="black-translucent"
    />

    <!-- The share card. 1200x630, drawn — not screenshotted — by
         `scripts/brand/og.mjs`, which explains why. `og:image` must be an
         absolute URL: a relative one resolves against the scraper, not the
         site, and simply produces a card with no picture. -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={page.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="The InertialRef mark and wordmark over a sunlit planet limb, with the figures 7,123 real systems, 150 light years cataloged, and nothing to install."
    />
    <meta property="og:locale" content="en" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={page.description} />
    <meta name="twitter:image" content={image} />

    <!--
      Structured data, for search engines and for the agents that read a page
      instead of looking at it.

      Two nodes because they answer two different questions: `WebSite` is "what
      is at this address", and `SoftwareApplication` is "what is the thing".
      `isAccessibleForFree`, `offers` at zero and the license are not decoration
      — they are the machine-readable form of the claim this project's front
      page makes in prose, and they are what stops it being classified as a
      demo for something purchasable.

      `/llms.txt` is the long-form version of the same, written for a reader
      that is not a person.
    -->
    <script type="application/ld+json" set:html={ld} />
    <!--
      The engine survives a click. ClientRouter swaps the document without
      a full load; `transition:persist` on the backdrop keeps the canvas,
      the renderer and the world. `fallback="swap"` skips the default fade
      so the picture does not blink while the chrome remounts.
      `transition:animate="none"` on `<html>` is the same decision for
      browsers that have View Transitions.
    -->
    <ClientRouter fallback="swap" />
  </head>
  <body>
    <!--
      What is on screen before the island mounts.

      The island fetches the packed catalog — 460 KB, a generation input rather
      than a decoration, so the world cannot be built without it — and until
      that resolves there is no canvas, no HUD and nothing in the slot. On a
      fast connection that is a flash; on a slow one, or behind a service
      worker serving a bundle that never parses, it is an indefinitely black
      page that is indistinguishable from a broken one. The audience that gets
      sent a link forms its impression in about a minute, and a minute of
      black is the whole minute.

      The island hides `#boot` when the application mounts, so this needs no
      other teardown. The stall timer below uses `#app` to know it has
      happened.

      Styles are inline literals because this has to render even if the
      stylesheet never arrives. The values are the design system's own tokens
      (sky-300, slate-500, amber-400, the monospace stack), written out rather
      than invented; this is not a second palette.
    -->
    <div id="root">
      <slot />
      <div
        id="boot"
        style="
          position: absolute;
          bottom: 0.75rem;
          left: 0.75rem;
          font-family:
            ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
          font-size: 12px;
          line-height: 1.3333;
        "
      >
        <div style="color: #7dd3fc">InertialRef</div>
        <div style="color: #64748b">reading the star catalog…</div>
        <div id="boot-stall" hidden style="margin-top: 0.5rem; color: #fbbf24">
          nothing has arrived in 10 s — the bundle or the catalog is not
          loading.
          <button
            type="button"
            id="boot-reload"
            style="
              margin-left: 0.25rem;
              border: 1px solid #334155;
              border-radius: 0.25rem;
              background: rgb(30 41 59 / 0.6);
              padding: 0.125rem 0.375rem;
              font: inherit;
              font-size: 10px;
              color: #cbd5e1;
              cursor: pointer;
            "
          >
            reload
          </button>
        </div>
      </div>
    </div>

    <slot name="noscript" />

    <script is:inline>
      /*
       * The one failure the page cannot report on its own.
       *
       * If the module never executes — a stale service worker holding a bundle
       * that 404s against a redeployed hash, a parse error on an old browser —
       * nothing in the island runs, so nothing in the island can say so. This
       * lives in the document instead. It is not a spinner: it appears only
       * once the wait has stopped being plausible, and it names the recovery
       * rather than the symptom, because the recovery is not "reload" — a
       * reload served by the same worker returns the same broken bundle.
       */
      setTimeout(function () {
        // The island mounted and hid #boot. Nothing to say.
        if (document.getElementById('app') !== null) return
        var boot = document.getElementById('boot-stall')
        if (boot === null) return
        boot.hidden = false
      }, 10000)

      document
        .getElementById('boot-reload')
        .addEventListener('click', function () {
          var done = function () {
            location.reload()
          }
          if ('serviceWorker' in navigator) {
            navigator.serviceWorker
              .getRegistrations()
              .then(function (all) {
                return Promise.all(
                  all.map(function (one) {
                    return one.unregister()
                  }),
                )
              })
              .then(done, done)
          } else done()
        })
    </script>
  </body>
</html>

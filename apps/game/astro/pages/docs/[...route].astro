---
import Base from '../../layouts/Base.astro'
import Islands from '../../components/Islands.astro'
import { DOCS } from '../../../src/pages/paths.ts'
import { pageMetaFor } from '../../../src/site.ts'
import { docCardDescription } from '../../../src/docs/urls.ts'
import {
  docsRoute,
  stagedManifest,
  stagedPage,
  staticDocsPaths,
} from '../../docsContent.ts'

export async function getStaticPaths() {
  const manifest = await stagedManifest()
  return staticDocsPaths(manifest)
}

const manifest = await stagedManifest()
const route = docsRoute(Astro.params.route)
const page = await stagedPage(manifest, route)
const description = docCardDescription(page.lead, pageMetaFor(DOCS).description)
---

<Base heading={page.title} description={description}>
  <Islands />
  <!--
    The document a scraper, a no-JS reader, and the first paint all see.

    The chrome island hides this once it mounts and draws the reading room
    itself. Until then — and without scripting, for the whole visit — the
    words are the page. `set:html` is the same markup `DocArticle` paints;
    it is generated from files in this repository by this repository's
    own build.
  -->
  <main id="doc-ssr" class="doc-ssr doc-prose" set:html={page.html} />
</Base>

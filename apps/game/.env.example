# Build-time public variables. Copy to `.env.production` for a deploy run from
# this machine; in CI the same names are set as Workers Builds *build*
# variables. Both are read by Vite at build time — an environment variable wins
# over a file of the same name.
#
# NOTHING SECRET MAY GO IN ONE. Anything Vite substitutes is in the bundle and
# is readable by anyone who opens the page.
#
# `.env*` is gitignored (this file excepted) because the repository is public.
# The GA measurement id is not a credential — it is visible in every request the
# tag makes — but an id committed here is an id every fork of this project
# measures into, and the person who owns the property is not the person who
# forked it. Left unset, `src/analytics.ts` loads nothing at all, which is the
# correct behavior for a fork.

# GA4 measurement id, `G-XXXXXXXXXX`. See `src/analytics.ts` for the three
# conditions that must also hold before the tag is loaded at all.
VITE_GA_MEASUREMENT_ID=

# Clerk's publishable key, `pk_test_…` or `pk_live_…`. See
# `src/account/accounts.ts`. `PUBLIC_` because Astro exposes nothing else to
# the browser. Not a secret — it names the instance and ships in the bundle —
# and still not committed, for the reason the GA id is not: a fork built from
# it would sign its visitors into somebody else's instance. Left unset, or set
# to anything that is not a real key, the build has no accounts: no badge, and
# account pages that say so.
#
# In Workers Builds it is a build variable on each trigger: the production
# instance's `pk_live_…` on the production (main) trigger, the development
# instance's `pk_test_…` on the non-production one. The Worker makes the same
# split by host with `CLERK_SECRET_KEY` and `CLERK_PREVIEW_SECRET_KEY`. For
# `pnpm dev`, the development key in `apps/game/.env.local`; the root
# `.env.local` is the Worker's alone.
PUBLIC_CLERK_PUBLISHABLE_KEY=

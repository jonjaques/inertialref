{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable", "WebWorker"],
    /* @webgpu/types is listed because `src/render/` calls navigator.gpu and
       GPUCanvasContext.configure directly. It arrives transitively through a
       `/// <reference types>` inside @types/three as well, which is precisely
       why it is named here: that reference is three's business and can go away
       on any bump, and this app would then stop compiling for reasons that have
       nothing to do with anything it changed. */
    "types": ["node", "vite/client", "@webgpu/types"],
    "jsx": "react-jsx",
    /* The `@/` alias, matching `resolve.alias` in vite.config.ts — see the
       comment there for why it exists at all. tsc and Vite resolve imports
       independently, so both have to be told, and the two must agree.

       No `baseUrl`: TypeScript 6 deprecates it outright, and without one these
       patterns resolve relative to this file, which is what was wanted. */
    "paths": { "@/*": ["./src/*"] }
  },
  "include": ["src", "vite.config.ts", "astro.config.ts", "astro/**/*.ts"]
}

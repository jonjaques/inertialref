{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable", "WebWorker"],
    /* @webgpu/types is listed because `src/render/` calls navigator.gpu and
       GPUCanvasContext.configure directly. It arrives transitively through a
       `/// <reference types>` inside @types/three as well, which is precisely
       why it is named here: that reference is three's business and can go away
       on any bump, and this app would then stop compiling for reasons that have
       nothing to do with anything it changed. */
    "types": ["node", "vite/client", "@webgpu/types"],
    "jsx": "react-jsx"
  },
  "include": ["src", "vite.config.ts"]
}

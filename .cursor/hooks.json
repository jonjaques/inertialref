{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "bash .claude/hooks/session-start.sh",
        "timeout": 300
      }
    ],
    "afterFileEdit": [
      {
        "command": "bash .claude/hooks/format-edited.sh",
        "timeout": 60
      }
    ],
    "stop": [
      {
        "command": "node .claude/hooks/gate.mjs",
        "timeout": 300,
        "loop_limit": 4
      }
    ]
  }
}

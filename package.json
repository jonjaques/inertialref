{
  "name": "inertialref",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:client": "pnpm --filter @inertialref/game dev",
    "dev:server": "pnpm --filter @inertialref/server run dev",
    "drive": "node scripts/drive.mjs",
    "trace": "node scripts/traceFrames.mjs",
    "timing": "node --max-old-space-size=8192 scripts/timing.mjs",
    "docs:build": "node scripts/docs/build.mjs",
    "format": "prettier -w .",
    "format:check": "prettier -c .",
    "build": "node scripts/media.mjs pull --optional && pnpm docs:build && pnpm typecheck && pnpm --filter @inertialref/game build",
    "preview": "pnpm build && pnpm --filter @inertialref/server exec wrangler dev",
    "preview:client": "pnpm --filter @inertialref/game preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:me": "vitest run --reporter=dot --reporter=vitest-nyancat-reporter",
    "test:gpu": "vitest run --config apps/game/vitest.gpu.config.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p apps/game/tsconfig.json && tsc -p apps/headless/tsconfig.json && tsc -p apps/server/tsconfig.json && tsc -p apps/ingest/tsconfig.json",
    "lint": "oxlint",
    "fta": "fta .",
    "fta:check": "fta . --score-cap 91",
    "graph": "node scripts/check-graph.mjs",
    "brand": "node scripts/brand/build.mjs",
    "brand:check": "node scripts/brand/build.mjs --check",
    "presets:plates": "node scripts/presets/plates.mjs",
    "presets:check": "node scripts/presets/check.mjs",
    "media:pull": "node scripts/media.mjs pull",
    "media:push": "node scripts/media.mjs push",
    "sim": "node --inspect=127.0.0.1:9229 apps/headless/src/main.ts",
    "catalog:fetch": "node apps/ingest/src/main.ts fetch",
    "catalog:report": "node apps/ingest/src/main.ts report",
    "catalog:build": "node apps/ingest/src/main.ts build",
    "textures:build": "node apps/ingest/src/main.ts textures",
    "solar:fetch": "node apps/ingest/src/main.ts solar",
    "shapes:build": "node apps/ingest/src/main.ts shapes",
    "deploy:worker": "pnpm build && pnpm --filter @inertialref/server run deploy",
    "check": "pnpm graph && pnpm brand:check && pnpm presets:check && pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@vitest/coverage-v8": "4.1.10",
    "fast-check": "^4.1.1",
    "fta-cli": "^3.0.1",
    "fontkit": "^2.0.4",
    "github-slugger": "^2.0.0",
    "marked": "^18.0.11",
    "oxlint": "^1.75.0",
    "prettier": "^3.9.6",
    "sharp": "^0.35.3",
    "shiki": "^4.4.3",
    "typedoc": "^0.28.20",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.0.5",
    "vitest-nyancat-reporter": "^1.0.0",
    "wawoff2": "^2.0.1"
  }
}
